<https://ogcsandpit.github.io/dqm-schemas/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - Data Quality Measures Schemas" ;
    dct:abstract """Implementation models (JSON/YAML schemas, but potentially XML and RDF)
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:description """Data Quality Measures may require complex (non-scalar) value objects, in which case canonical schemas for these values are required to achieve interoperability.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:modified "2026-09-24T22:52:28.739912"^^xsd:dateTime ;
    owl:imports <https://opengeospatial.github.io/bblocks/register.json> ;
    skos:hasTopConcept <bblocks://ogc.dqm.schemas.eg_usage>,
        <bblocks://ogc.dqm.schemas.extraneous_nodes>,
        <bblocks://ogc.dqm.schemas.measure> ;
    skos:prefLabel "Building Blocks - Data Quality Measures Schemas" ;
    prof:hasResource [ rdfs:label "This Building Blocks Register in JSON format" ;
            dct:type "application/json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://ogcsandpit.github.io/dqm-schemas/build/register.json> ],
        [ rdfs:label "This Building Blocks Register in RDF Turtle format" ;
            dct:type "text/turtle" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://ogcsandpit.github.io/dqm-schemas/build/bblocks.ttl> ],
        [ rdfs:label "This Building Blocks Register in JSON-LD format" ;
            dct:type "application/ld+json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://ogcsandpit.github.io/dqm-schemas/build/bblocks.jsonld> ] ;
    foaf:homepage <https://ogcsandpit.github.io/dqm-schemas/> ;
    bblocks:hasValidationReport <https://ogcsandpit.github.io/dqm-schemas/build/tests/report.html> .

